{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.csr.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.csr.html", "/manifest.json", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/fonts/**", "/media/**", "/*.png", "/*.woff2"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "nbu-exchange-rates",
      "urls": ["https://bank.gov.ua/NBUStatService/**"],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 500,
        "maxAge": "30d"
      }
    }
  ]
}
